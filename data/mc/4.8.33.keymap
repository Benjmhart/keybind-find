# Midnight Commander 4.8.33's compiled-in default keymap: src/keymap.c's default_*_keymap arrays as
# create_default_keymap() loads them before any keymap file, generated by a script kept out of this repo.
# Source: https://ftp.osuosl.org/pub/midnightcommander/mc-4.8.33.tar.xz,
# SHA-256 cae149d42f844e5185d8c81d7db3913a8fa214c65f852200a9d896b468af164c (matches mc-4.8.33.sha256 there).
# Not misc/mc.default.keymap: at 4.8.33 the two differ (editor, help, menu, tree, viewer:hex, filemanager:xmap).
# A build with every optional feature (charset, VFS, ext2 attributes, background, diff viewer, internal editor,
# aspell); `#if 0` entries left out. As in mc, default_chattr_keymap is loaded into [help], not [chattr].

[filemanager]
ChangePanel = tab; ctrl-i
Help = f1
UserMenu = f2
View = f3
Edit = f4
Copy = f5
Move = f6
MakeDir = f7
Delete = f8
Menu = f9
Quit = f10
MenuLastSelected = f19
QuitQuiet = f20
History = alt-h
EditorViewerHistory = alt-shift-e
DirSize = ctrl-space
PutCurrentPath = alt-a
PutOtherPath = alt-shift-a
PutCurrentSelected = alt-enter; ctrl-enter
PutCurrentFullSelected = ctrl-shift-enter
CdQuick = alt-c
HotList = ctrl-backslash
Suspend = ctrl-z
ViewFiltered = alt-exclamation
Find = alt-question
Reread = ctrl-r
Swap = ctrl-u
SplitEqual = alt-equal
SplitMore = alt-shift-right
SplitLess = alt-shift-left
Shell = ctrl-o
ShowHidden = alt-dot
SplitVertHoriz = alt-comma
ExtendedKeyMap = ctrl-x
Select = kpplus
Unselect = kpminus
SelectInvert = kpasterisk
ScreenList = alt-prime

[filemanager:xmap]
