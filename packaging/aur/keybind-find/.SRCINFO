pkgbase = keybind-find
	pkgdesc = Search the keybindings for the focused window and run the one you pick
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/Benjmhart/keybind-find
	arch = x86_64
	license = MIT
	checkdepends = neovim
	makedepends = cargo
	depends = glibc
	depends = libgcc
	optdepends = xdotool: X11: read the focused window and send the picked keys
	optdepends = xorg-xprop: X11: read the window class, title and pid
	optdepends = xorg-xmodmap: key search, and checking config.toml keys
	optdepends = fzf: the list on X11 (0.66+ for key search)
	optdepends = alacritty: the window fzf runs in
	optdepends = dmenu: the list on X11 without fzf or alacritty
	optdepends = fuzzel: the list on Wayland
	optdepends = wtype: Wayland: send the picked keys
	optdepends = libnotify: show errors when run from a hotkey
	optdepends = neovim: list the bindings of nvim
	optdepends = tmux: list the bindings of tmux and the program in its pane
	optdepends = espanso: list espanso snippets
	source = keybind-find-1.0.0.tar.gz::https://github.com/Benjmhart/keybind-find/archive/v1.0.0.tar.gz
	sha256sums = SKIP

pkgname = keybind-find
