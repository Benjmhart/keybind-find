pkgbase = keybind-find-bin
	pkgdesc = A command palette for your whole workspace, built from the keybindings of your window manager and apps (prebuilt static binary)
	pkgver = 1.4.1
	pkgrel = 1
	url = https://github.com/Benjmhart/keybind-find
	arch = x86_64
	license = MIT
	optdepends = xdotool: X11: read the focused window and send the picked keys
	optdepends = xorg-xprop: X11: read the window class, title and pid
	optdepends = xorg-xmodmap: key search, and checking config.toml keys
	optdepends = fzf: the list on X11 (0.66+ for key search)
	optdepends = alacritty: the window fzf runs in
	optdepends = dmenu: the list on X11 without fzf or alacritty
	optdepends = fuzzel: the list on Wayland
	optdepends = wtype: Wayland: send the picked keys (not KDE Plasma or GNOME)
	optdepends = xdg-desktop-portal-kde: KDE Plasma on Wayland: send the picked keys
	optdepends = xdg-desktop-portal-gnome: GNOME on Wayland: send the picked keys
	optdepends = libnotify: show errors when run from a hotkey
	optdepends = neovim: list the bindings of nvim
	optdepends = tmux: list the bindings of tmux and the program in its pane
	optdepends = espanso: list espanso snippets
	provides = keybind-find
	conflicts = keybind-find
	options = !strip
	options = !debug
	source_x86_64 = https://github.com/Benjmhart/keybind-find/releases/download/v1.4.1/keybind-find-1.4.1-x86_64-unknown-linux-musl.tar.gz
	sha256sums_x86_64 = 62d2b0f24b5649f017394790ff4a00a080bef0479017c4d883b94b530d29bd9a

pkgname = keybind-find-bin
