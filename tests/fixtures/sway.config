# Synthetic sway config for the sway provider's tests (not anyone's real config).
set $mod Mod4
set $term alacritty

bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym --release Print exec grim
bindsym Control+space [urgent=latest] focus
bindsym $mod+d exec fuzzel \
    --width 60

# bindsym $mod+z exec commented-out
    #    bindsym $mod+z exec indented-comment

# Used before it is set: stays literal.
bindsym $mod+b exec $browser
set $browser firefox

bindcode $mod+38 exec not-a-keysym

mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Right resize grow width 10px
    bindsym Escape mode "default"
}

bar {
    bindsym button4 workspace prev
    bindsym Mod4+p exec bar-only
}

include sway.config.d/extra.conf
set $cfg sway.config.d
include $cfg/setvar.conf
include "sway.config.d/quoted.conf"
# Matches y.dot, not the dotfile .x.dot.
include sway.config.d/*.dot
include sway.config.d/$KBF_HOST.conf
include sway.config.d/glob-*.conf
include sway.config.d/$KBF_UNSET.conf
include sway.config.d/missing.conf
# Already read: skipped, so includes can't loop.
include sway.config
