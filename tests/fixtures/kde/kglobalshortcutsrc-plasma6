[$Version]
update_info=kglobalaccel.upd:kde3.4

[ksmserver]
Lock Session=Meta+Q,none,Overwritten by the next line
Lock Session=Meta+L\tScreensaver,Meta+L\tScreensaver,Lock Session
_k_friendly_name=Session Management

[kwin]
Comma Key=Meta+\\,,none,
Comma Name=Meta+Shift+C,none,Zoom\\, then pan
Expose=Meta+E\tLaunch (1),Ctrl+F9,Toggle Present Windows (Current desktop)
Keypad=Num+5,none,Keypad Five
Not ASCII=Meta+É,none,Accent
Play Pause=Toggle Media Play/Pause,none,Play or Pause
Sequence=Meta+K\\, Meta+L,none,Two Chords
Show Desktop=none,Meta+D,Peek at Desktop
Switch Window Left=Meta+Ctrl+Left,none,Switch to Window to the Left
Volume=Volume Up,Volume Up,Increase Volume
Walk Through Windows (Reverse)=Alt+Shift+Backtab,Alt+Shift+Backtab,Walk Through Windows (Reverse)
Window Close=Alt+F4,Alt+F4,Close Window
Window Maximize=,Meta+PgUp,Maximize Window
_k_friendly_name=KWin

[kwin][$InverseAction]
Window Close=Meta+Q

[kwin][Overview]
Overview Only=Meta+O,none,Only in another context

[org.kde.kmix]
mute=Volume Mute,Volume Mute,Mute

[services][org.example.named.desktop]
_launch=Meta+F

[services][org.example.deleted.desktop]
_launch=Meta+Z

[services][org.example.notes.desktop]
edit=Meta+Shift+E
new=Meta+Shift+N
stale=Meta+Shift+S

[services][org.kde.dolphin.desktop]
_launch=none

[services][org.kde.konsole.desktop]
_launch=Ctrl+Alt+K
