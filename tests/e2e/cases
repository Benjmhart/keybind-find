# The e2e cases, sourced by harness.sh once per phase (PHASE=x11, awesome, openbox, wayland, then niri).
# Each names its case, the providers that must answer (each with at least one bind), and one key from tests/e2e/home
# that must be listed: "PROVIDER|KEY|part of its description[|scope=value,...]". x: under i3, or under awesome or
# Openbox in its phase (the focused window found through xdotool); w: under sway; p NAME MODE: picks through a fake portal under a
# faked GNOME session on sway's display (harness.sh `p`); n: under niri; d: one provider dumped directly, after a setup
# command (its desktop can't run here); o NAME PROVIDER -- COMMAND: the program's own key report (COMMAND) checked
# against `keybind-find dump PROVIDER` by oracle.py. The niri phase runs only when its name is wanted: name
# `niri-phase` with any niri case.
if [ "$PHASE" = x11 ]; then
  # Programs in a terminal with no keys of its own (xterm), and i3's own keys.
  x xterm-zsh      "i3 zsh"     "i3|super+Return|exec xterm"        -- xterm -e zsh
  x zsh            "i3 zsh"     "zsh|ctrl+x k|kill-whole-line"      -- xterm -e zsh
  x bash           "i3 bash"    "bash|ctrl+x k|kill-whole-line"     -- xterm -e bash
  x fish           "i3 fish"    "fish|alt+k|kill-whole-line"        -- xterm -e fish
  x helix          "i3 helix"   "helix|ctrl+s|Write changes"        -- xterm -e helix /tmp/e2e.rs
  x vim-headless   "i3 vim"     "vim|space w|:w<CR>"                -- xterm -e vim /tmp/e2e.c
  # The buffer's own map, which only the running vim has: proves the live read.
  x vim-live       "i3 vim"     'vim|space b|:echo "buffer"|buffer=current,filetype=c' -- xterm -e vim --servername E2E /tmp/e2e.c
  x nano           "i3 nano"    "nano|ctrl+s|Save file"             -- xterm -e nano /tmp/e2e.c
  x micro          "i3 micro"   "micro|alt+s|Save"                  -- xterm -e micro /tmp/e2e.c
  x mc             "i3 mc"      "mc|alt+y|Quit"                     -- xterm -e mc
  x ranger         "i3 ranger"  "ranger|shift+x|quit"               -- xterm -e ranger
  x ncmpcpp        "i3 ncmpcpp" "ncmpcpp|shift+x|quit"              -- xterm -e ncmpcpp
  x yazi           "i3 yazi"    "yazi|shift+x|e2e quit"             -- xterm -e yazi
  # Y is bound only by on-init in the running lf (tests/e2e/home/.config/lf/lfrc): proves the live read. lf takes its
  # home from passwd (/home/tester), not $HOME, so LF_CONFIG_HOME points it at the e2e config.
  x lf             "i3 lf"      "lf|shift+y|e2e-live|mode=normal"   -- xterm -e env LF_CONFIG_HOME="$HOME/.config" lf
  # lazygit reads $HOME/.config/lazygit/config.yml (tests/e2e/home): X is its quit there. No oracle: lazygit prints only
  # its defaults.
  wanted lazygit && { rm -rf /tmp/e2e-repo && git init -q /tmp/e2e-repo; }
  x lazygit        "i3 lazygit" "lazygit|shift+x|Quit"              -- xterm -e lazygit -p /tmp/e2e-repo
  # Where the keys come from: `dump`'s `source`, its installed version checked against the program's own report.
  # lazygit's own, a stub's older one, the five probes, a failed probe, VS Code unchecked, and a provider with none.
  if wanted defaults-source; then
    # ds_dump NAME PROVIDER [ENV...]: `dump PROVIDER` under `env ENV...`, to $OUT/defaults-source-NAME.{json,err}.
    ds_dump() { local n=$1 p=$2; shift 2; env "$@" timeout 60 "$KBF" dump "$p" >"$OUT/defaults-source-$n.json" 2>"$OUT/defaults-source-$n.err"; }
    # ds_is NAME SOURCE-JSON ("null": no `source` key): the dump's source, and binds listed.
    ds_is() {
      python3 -I -c 'import json,sys
s=json.load(open(sys.argv[1])); want=json.loads(sys.argv[2])
assert ("source" in s) == (want is not None) and s.get("source") == want, s.get("source")
assert sum(map(len, s["binds"].values())) > 0, "no binds"' "$OUT/defaults-source-$1.json" "$2" >/dev/null 2>&1 ||
        { ds_why+="$1: $(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("source"))' "$OUT/defaults-source-$1.json" 2>&1 | tail -1); "; }
    }
    ds_src() { printf '{"defaults": "%s", "installed": %s, "checked": %s, "mismatch": %s}' "$@"; }
    ds_why=""
    ds_v=$(lazygit --version | sed -n 's/.*version=\([^,]*\),.*/\1/p')
    ds_dump lazygit lazygit
    ds_is lazygit "$(ds_src 0.66.2 "\"$ds_v\"" true false)"
    ds_tmp=$(mktemp -d)
    mkdir "$ds_tmp/old" "$ds_tmp/fail"
    printf '#!/bin/sh\necho "commit=e2e, build date=unknown, build source=e2e, version=0.60.0, os=linux, arch=amd64, git version=2.51.0"\n' >"$ds_tmp/old/lazygit"
    printf '#!/bin/sh\nexit 1\n' >"$ds_tmp/fail/mc"
    chmod 755 "$ds_tmp/old/lazygit" "$ds_tmp/fail/mc"
    ds_dump lazygit-old lazygit PATH="$ds_tmp/old:$PATH"
    ds_is lazygit-old "$(ds_src 0.66.2 '"0.60.0"' true true)"
    grep -qF 'lazygit 0.60.0: using the defaults of 0.66.2; add data/lazygit/0.60.0.toml' "$OUT/defaults-source-lazygit-old.err" ||
      ds_why+="lazygit-old: no note; "
    # Each probe against the program's own report: the pin is the snapshot's version (konsole with no display).
    ds_dump konsole konsole -u DISPLAY -u WAYLAND_DISPLAY
    for ds_p in "konsole 26.08.2" "mc 4.8.33" "ranger 1.9.4" "ncmpcpp 0.10.1" "lf 42"; do
      read -r ds_prog ds_pin <<<"$ds_p"
      [ "$ds_prog" = konsole ] || ds_dump "$ds_prog" "$ds_prog"
      ds_is "$ds_prog" "$(ds_src "$ds_pin" "\"$ds_pin\"" true false)"
      case $ds_prog in
        konsole) ds_own=$(env -u DISPLAY -u WAYLAND_DISPLAY QT_QPA_PLATFORM=offscreen konsole --version 2>/dev/null) ;;
        lf) ds_own=$(lf -version) ;;
        *) ds_own=$("$ds_prog" --version 2>/dev/null) ;;
      esac
      # The pin as a whole word of the report (`42`, not the `42` in `r142`).
      [[ " $(printf '%s' "$ds_own" | tr -s '[:space:]' ' ') " == *" $ds_pin "* ]] ||
        ds_why+="$ds_prog: its own report lacks $ds_pin; "
    done
    ds_dump mc-fail mc PATH="$ds_tmp/fail:$PATH"
    ds_is mc-fail "$(ds_src 4.8.33 null true true)"
    grep -qF "mc's version is unknown: using the defaults of 4.8.33" "$OUT/defaults-source-mc-fail.err" ||
      ds_why+="mc-fail: no note; "
    ds_dump vscode vscode
    ds_is vscode "$(ds_src 1.143.1 null false false)"
    ds_dump less less
    ds_is less null
    # Bare `dump` (every sheet for the focused window) carries it too: nano's, in an xterm.
    ds_before=$(xdotool getactivewindow 2>/dev/null)
    setsid xterm -e nano >/dev/null 2>&1 &
    ds_pid=$!
    for _ in $(seq 150); do
      ds_w=$(xdotool getactivewindow 2>/dev/null)
      [ -n "$ds_w" ] && [ "$ds_w" != "$ds_before" ] && break
      sleep 0.1
    done
    sleep 1
    timeout 60 "$KBF" dump >"$OUT/defaults-source-all.json" 2>"$OUT/defaults-source-all.err"
    python3 -I -c 'import json,sys
s=[x for x in json.load(open(sys.argv[1])) if x["provider"] == "nano"]
assert len(s) == 1 and s[0]["source"]["checked"] and s[0]["source"]["defaults"], s' "$OUT/defaults-source-all.json" >/dev/null 2>&1 ||
      ds_why+="dump: no nano sheet with a source; "
    i3-msg -q kill >/dev/null 2>&1
    sleep 0.3; kill -- -"$ds_pid" 2>/dev/null; sleep 0.3
    rm -rf "$ds_tmp"
    if [ -z "$ds_why" ]; then
      record defaults-source "ok	lazygit $ds_v: no mismatch; 0.60.0: mismatch and note; konsole mc ranger ncmpcpp lf: their own versions; mc failing: unknown; vscode unchecked; less none; dump: nano's source"
    else
      record defaults-source "FAIL	$ds_why"; FAILED=1
    fi
  fi
  # nnn's plugin keys come from its NNN_PLUG, which only the running nnn has (the harness sets none): proves the environ
  # read.
  x nnn            "i3 nnn"     "nnn|semicolon x|e2e quit"          -- xterm -e env NNN_PLUG='x:!echo e2e quit' nnn /tmp
  # `space b` is mapped only in each window, by a WinCreate hook in tests/e2e/home/.config/kak/kakrc: only the live
  # read from the running session lists it. No kak outlives the case.
  x kakoune        "i3 kakoune" "kakoune|space b|e2e window|mode=normal" -- xterm -e kak /tmp/e2e.c
  wanted kakoune && { pkill -x kak; for _ in $(seq 50); do pgrep -x kak >/dev/null || break; sleep 0.1; done
    ! pkill -9 -x kak || { record kakoune-cleanup "FAIL	a kak outlived SIGTERM for 5 s"; FAILED=1; }; }
  # `comma l` is bound only by tests/e2e/home/.config/qutebrowser/e2e-live.py (not config.py: the fallback never reads
  # it): only the live read from the running browser lists it. QtWebEngine runs with software rendering and without
  # Chromium's sandbox (a container's seccomp refuses it); both are temporary settings. No qutebrowser outlives a case.
  qute_gone() {
    pkill -x qutebrowser
    for _ in $(seq 100); do pgrep -x qutebrowser >/dev/null || pgrep -x QtWebEngineProc >/dev/null || break; sleep 0.1; done
    ! pkill -9 -x qutebrowser && ! pkill -9 -x QtWebEngineProc ||
      { record "$1-cleanup" "FAIL	a qutebrowser outlived SIGTERM for 10 s"; FAILED=1; }
  }
  x qutebrowser-live "i3 qutebrowser" "qutebrowser|comma l|e2e live" 3 -- qutebrowser --config-py "$HOME/.config/qutebrowser/e2e-live.py" -s qt.force_software_rendering chromium -s qt.chromium.sandboxing disable-all about:blank
  # Its one note: the two keys keybind-find can't send (<Num+5>, <Guide> in autoconfig.yml).
  if wanted qutebrowser-live; then
    notes=$(grep '^keybind-find: qutebrowser: ' "$OUT/qutebrowser-live.err")
    case $notes in
      "keybind-find: qutebrowser: leaving out 2 key(s) "*[!$'\n']) record qutebrowser-live-note "ok	leaving out 2 key(s)" ;;
      *) record qutebrowser-live-note "FAIL	$(echo "$notes" | tr '\n\t' '  ' | cut -c1-300)"; FAILED=1 ;;
    esac
    qute_gone qutebrowser-live
  fi
  # The same browser running, an xterm focused: `dump qutebrowser` never asks it (comma l absent), it reads the files.
  if wanted qutebrowser-unfocused; then
    setsid qutebrowser --config-py "$HOME/.config/qutebrowser/e2e-live.py" -s qt.force_software_rendering chromium \
      -s qt.chromium.sandboxing disable-all about:blank >"$OUT/qutebrowser-unfocused.app.log" 2>&1 &
    # Not named `focused`: that is the harness's (the niri cases call it), and a function here would replace it.
    qute_wait_class() { for _ in $(seq 150); do [ "$(xdotool getactivewindow getwindowclassname 2>/dev/null)" = "$1" ] && break; sleep 0.1; done; }
    for _ in $(seq 150); do ls "$XDG_RUNTIME_DIR"/qutebrowser/ipc-* >/dev/null 2>&1 && break; sleep 0.1; done
    qute_wait_class qutebrowser
    setsid xterm -e zsh >/dev/null 2>&1 &
    xt=$!
    qute_wait_class XTerm
    timeout 60 "$KBF" dump qutebrowser >"$OUT/qutebrowser-unfocused.json" 2>"$OUT/qutebrowser-unfocused.err"
    if line=$(python3 -I -c 'import json,sys; s=json.load(open(sys.argv[1])); n=s["binds"]["normal"]
k=[b["key"] for b in n]; assert "comma a" in k and "comma l" not in k, k[-5:]
print("qutebrowser:%d, no comma l" % sum(map(len, s["binds"].values())))' \
        "$OUT/qutebrowser-unfocused.json" 2>&1) && ls "$XDG_RUNTIME_DIR"/qutebrowser/ipc-* >/dev/null 2>&1 &&
      ! grep -q 'the running qutebrowser' "$OUT/qutebrowser-unfocused.err" &&
      ! ls -d "$XDG_RUNTIME_DIR"/qutebrowser/keybind-find-qute-* >/dev/null 2>&1; then
      record qutebrowser-unfocused "ok	$line"
    else
      record qutebrowser-unfocused "FAIL	$(echo "$line" | tail -1)	$(tr '\n\t' '  ' < "$OUT/qutebrowser-unfocused.err" | cut -c1-300)"; FAILED=1
    fi
    kill -- -"$xt" 2>/dev/null
    qute_gone qutebrowser-unfocused
  fi
  # FALLBACK's limits with the real qutebrowser Python: each hostile autoconfig.yml is one note and the 295 defaults;
  # one just at each limit (4 MiB; depth 32, root 0; 100000 values counting the root) is read: no note. deep* nest under a
  # key commands() ignores, so only the depth limit can give the note.
  if wanted qutebrowser-caps; then
    ok=1 why=""
    for c in fifo big deep bomb nan many big-ok deep-ok many-ok; do
      h=/tmp/qcap/$c; rm -rf "$h"; mkdir -p "$h/.config/qutebrowser"; f=$h/.config/qutebrowser/autoconfig.yml
      case $c in
        fifo) mkfifo "$f" ;;
        big|big-ok) head -c $((4 * 1024 * 1024 + $([ $c = big ] && echo 1 || echo 0))) /dev/zero 2>/dev/null | tr '\0' '#' >"$f" ;;
        deep|deep-ok) python3 -I -c 'import sys; n = int(sys.argv[1]); print("config_version: 2\nsettings:\n  x: " + "[" * n + "]" * n)' \
          "$([ $c = deep ] && echo 40 || echo 31)" >"$f" ;;
        bomb) python3 -I -c 'print("a: &a [" + ",".join(["x"] * 50) + "]"); [print(f"{n}: &{n} [" + ",".join([f"*{p}"] * 50) + "]") for p, n in zip("abcd", "bcde")]' >"$f" ;;
        nan) printf 'config_version: 2\nsettings:\n  x: {global: .nan}\n' >"$f" ;;
        # 7 values besides the list's: the root, config_version and 2, settings and its mapping, x, the list.
        many|many-ok) python3 -I -c 'import sys; print("config_version: 2\nsettings:\n  x: [" + ",".join(["0"] * int(sys.argv[1])) + "]")' \
          "$([ $c = many ] && echo 99994 || echo 99993)" >"$f" ;;
      esac
      env -u XDG_CONFIG_HOME HOME="$h" timeout 30 "$KBF" dump qutebrowser >"$OUT/qutebrowser-caps-$c.json" 2>"$OUT/qutebrowser-caps-$c.err"
      n=$(python3 -I -c 'import json,sys; print(sum(map(len, json.load(open(sys.argv[1]))["binds"].values())))' "$OUT/qutebrowser-caps-$c.json" 2>/dev/null)
      notes=$(grep -c '^keybind-find: qutebrowser: ' "$OUT/qutebrowser-caps-$c.err")
      case $c in
        *-ok) [ "$n" = 295 ] && [ "$notes" = 0 ] ;;
        *) [ "$n" = 295 ] && [ "$notes" = 1 ] && grep -q 'listing the defaults only' "$OUT/qutebrowser-caps-$c.err" ;;
      esac || { ok=""; why+="$c: $n binds, $notes notes; "; }
    done
    if [ -n "$ok" ]; then record qutebrowser-caps "ok	fifo big deep bomb nan many: one note each; big-ok deep-ok many-ok: none; 295 defaults"
    else record qutebrowser-caps "FAIL	$why"; FAILED=1; fi
  fi
  x emacs-nw       "i3 emacs"   "emacs|ctrl+c k|kill-buffer"        -- xterm -e emacs -nw /tmp/e2e.c
  # c-mode's map, which only the running Emacs's C buffer has (the batch read lists the global map): proves the
  # server path.
  wanted emacsclient-t && emacs --daemon >/dev/null 2>&1
  x emacsclient-t  "i3 emacs"   "emacs|ctrl+c j|kill-buffer"        -- xterm -e emacsclient -t /tmp/e2e.c
  x screen         "i3 screen"  "screen|ctrl+a shift+x|quit"        -- xterm -e screen
  x tmux           "i3 tmux"    "tmux|ctrl+b X|kill-server"         -- xterm -e tmux
  # Alt as ESC: by default xterm sets the eighth bit instead (Alt+y types `ù`), which zellij doesn't read as Alt.
  x zellij         "i3 zellij"  "zellij|alt+y|NewTab|input_mode=normal" -- xterm -xrm 'XTerm*metaSendsEscape: true' -e zellij
  # nvim in zellij's one pane, from `zellij action list-clients`. The zellij case's server goes first, gone before the
  # case starts (with two sessions zellij asks which), and the server gets EDITOR=nvim: zellij shows a pane running nvim
  # on one file under its editor's name when that is vi, vim or nvim (vi when unset).
  wanted zellij-nvim && pkill -x zellij && for _ in $(seq 50); do pgrep -x zellij >/dev/null || break; sleep 0.1; done
  wanted zellij-nvim && { ! pgrep -x zellij >/dev/null || echo "zellij still running" >&2; }
  x zellij-nvim    "i3 zellij nvim" "nvim|backslash x|e2e quit"       -- xterm -e env EDITOR=nvim zellij --layout /tmp/home/.config/zellij/nvim.kdl
  pkill -x zellij || true
  # The README demo (docs/media/record.sh): nvim on a config of its own in alacritty, where Space u l turns the dark
  # colour scheme light. NVIM_TEST only hides nvim's warning when the terminal answers its colour query after 100 ms.
  x nvim-demo      "i3 nvim"    "nvim|space u l|Toggle light theme" -- alacritty --working-directory "$HOME/.config/nvim" -e env NVIM_TEST=1 nvim -u demo.lua demo.lua
  x less           "i3 less"    "less|X|quit"                       -- xterm -e less /etc/os-release
  # sxhkd's hotkeys beside i3's, from the sxhkd running on this display (stopped after, so later cases don't list it).
  # sxhkd exits without SHELL (it runs commands through it), which the harness leaves unset.
  wanted sxhkd && { SHELL=/bin/sh sxhkd >"$OUT/sxhkd.log" 2>&1 & }
  wanted sxhkd && for _ in $(seq 50); do pgrep -x sxhkd >/dev/null && break; sleep 0.1; done
  x sxhkd          "i3 sxhkd zsh" "sxhkd|super+alt+x|e2e quit"       -- xterm -e zsh
  wanted sxhkd && pkill -x sxhkd && for _ in $(seq 50); do pgrep -x sxhkd >/dev/null || break; sleep 0.1; done
  # Terminals with keys of their own, a shell inside.
  x alacritty      "i3 alacritty zsh"       "alacritty|ctrl+shift+x|Quit"          -- alacritty -e zsh
  x kitty          "i3 kitty zsh"           "kitty|ctrl+shift+x|close_window"      -- kitty zsh
  x ghostty        "i3 ghostty zsh"         "ghostty|ctrl+shift+x|close_surface"   -- ghostty -e zsh
  x xfce4-terminal "i3 xfce4_terminal zsh"  "xfce4_terminal|ctrl+shift+n|Open Tab" -- xfce4-terminal --disable-server -x zsh
  wanted gnome-terminal && gsettings set org.gnome.Terminal.Legacy.Keybindings:/org/gnome/terminal/legacy/keybindings/ close-tab '<Control><Shift>x'
  x gnome-terminal "i3 gnome-terminal zsh"  "gnome-terminal|ctrl+shift+x|close tab" -- gnome-terminal --wait -- zsh
  x urxvt          "i3 zsh"                 "zsh|ctrl+x k|kill-whole-line"         -- urxvt -e zsh
  x terminator     "i3 zsh"                 "zsh|ctrl+x k|kill-whole-line"         -- terminator -x zsh
  x wezterm        "i3 wezterm zsh"         "wezterm|ctrl+shift+x|CloseCurrentTab" -- wezterm start --always-new-process -- zsh
  x konsole        "i3 konsole zsh"         "konsole|ctrl+shift+x|Close Window"    -- konsole -e zsh
  # A second pane, focused on creation: the program in it comes from `wezterm cli list-clients`.
  x wezterm-split  "i3 wezterm helix"       "helix|ctrl+s|Write changes"           -- wezterm start --always-new-process -- zsh -c 'wezterm cli split-pane -- helix /tmp/e2e.rs; exec zsh'
  # Apps by window class.
  x zathura        "i3 zathura"  "zathura|shift+x|quit"                   -- zathura
  x mpv            "i3 mpv"      "mpv|shift+x|quit"                       -- mpv --idle --force-window
  x code           "i3 vscode"   "vscode|ctrl+shift+x|workbench.action.quit" -- code --no-sandbox --disable-gpu --new-window /tmp/e2e.rs
  x obsidian       "i3 obsidian" "obsidian|ctrl+shift+x|app:quit"         -- obsidian --no-sandbox
  x zed            "i3 zed"      "zed|ctrl+shift+x|CloseWindow"           -- zeditor --foreground /tmp/e2e.rs
  # Desktops that can't run here: their providers, from the settings store.
  d xfce   xfce  "xfce|super+t|xterm"   -- sh -c "xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>t' -n -t string -s xterm && xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom/override -n -t bool -s true"
  d gnome  gnome "gnome|super+q|close"  -- gsettings set org.gnome.desktop.wm.keybindings close "['<Super>q']"
  # The program as oracle: its own report of its effective keys against `keybind-find dump PROVIDER`, key for key
  # (tests/e2e/oracle.py; known differences listed there with their reasons).
  o kitty-oracle kitty -- kitty +runpy "$(cat "$E/oracle-kitty.py")" "$HOME/.config/kitty/kitty.conf"
  o wezterm-oracle wezterm -- wezterm show-keys --lua
  # zellij prints no effective keys: its preset is the oracle, the config's changes its KNOWN differences.
  o zellij-oracle zellij -- zellij setup --dump-keybinds default
  # lf's own `query` answer is its live path, so the oracle checks the fallback: lf is gone before the dump, which
  # reads lfrc over the pinned defaults.
  o lf-oracle lf -- sh "$E/oracle-lf.sh"
  # nnn's help screen (its PAGER, from tmux) against the dump; the dump, with no nnn in front, reads the same
  # NNN_PLUG and NNN_BMS from the harness.
  wanted nnn-oracle && export NNN_PLUG='x:!echo e2e quit;f:finder' NNN_BMS='d:/tmp'
  o nnn-oracle nnn -- sh "$E/oracle-nnn.sh"
  unset NNN_PLUG NNN_BMS
  # Kakoune's own `debug mappings` in a client (tests/e2e/oracle-kakoune.kak) against the dump, which, with no kak in
  # front, reads the same kakrc and Kakoune's runtime autoload.
  o kakoune-oracle kakoune -- kak -ui dummy -e "source $E/oracle-kakoune.kak"
  # qutebrowser's own get_bindings_for per mode (tests/e2e/oracle-qutebrowser.py, run at startup, then :quit) against
  # the dump, which, with no qutebrowser in front, reads the same autoconfig.yml over the pinned defaults.
  o qutebrowser-oracle qutebrowser -- qutebrowser -s qt.force_software_rendering chromium -s qt.chromium.sandboxing disable-all ":debug-pyeval --file $E/oracle-qutebrowser.py" ":quit"
  wanted qutebrowser-oracle && qute_gone qutebrowser-oracle
elif [ "$PHASE" = awesome ]; then
  # awesome on the same display, i3 stopped: its keys from the running awesome over D-Bus
  # (tests/e2e/home/.config/awesome/rc.lua: the stock rc.lua plus keys of our own).
  x awesome        "awesome zsh"  "awesome|super+shift+x|e2e quit"   -- xterm -e zsh
  # awesome's own report: its installed root.keys() as hex MODS,KEY, without the Lock and Mod2 variants awful.key adds
  # (lib/awful/key.lua:24,120-130 at v4.3), deduplicated. Global keys only: the stock rc's client keys are KNOWN.
  AWESOME_REPORT='local function h(s) return (s:gsub(".", function(c) return ("%02x"):format(c:byte()) end)) end
local o, seen = {}, {}
for _, k in ipairs(root.keys()) do
  local m = {}
  for _, x in ipairs(k.modifiers) do if x ~= "Lock" and x ~= "Mod2" then m[#m + 1] = x end end
  local e = h(table.concat(m, "\0")) .. "," .. h(k.key or "")
  if not seen[e] then seen[e], o[#o + 1] = true, e end
end
return table.concat(o, ";")'
  o awesome-oracle awesome -- dbus-send --session --dest=org.awesomewm.awful --type=method_call --print-reply \
    --reply-timeout=2000 / org.awesomewm.awful.Remote.Eval "string:$AWESOME_REPORT"
elif [ "$PHASE" = openbox ]; then
  # Openbox on the same display, i3 and awesome stopped: its keybinds from tests/e2e/home/.config/openbox/rc.xml. Openbox
  # prints no report of its bindings, so there is no oracle case.
  x openbox        "openbox zsh"  "openbox|super+shift+x|e2e quit"   -- xterm -e zsh
  # The same dump: the chain listed as a key sequence, and the H-x keybind left out and counted. A skip (not a failure)
  # when the openbox case didn't pass here: it fails on its own, or wasn't run (CASES=openbox-chain alone).
  if ! wanted openbox-chain; then :
  elif [[ " ${RESULTS[*]} " != *$' openbox\tok\t'* ]]; then
    record openbox-chain "skip	the openbox case didn't pass in this run"
  elif line=$(python3 -I "$E/check.py" "$OUT/openbox.json" "openbox" "openbox|super+a t|e2e chain" 2>&1) &&
    grep -q 'openbox: leaving out: 1 with a Meta, Hyper' "$OUT/openbox.err"; then
    record openbox-chain "ok	$line"
  else
    record openbox-chain "FAIL	$line	$(tr '\n\t' '  ' < "$OUT/openbox.err" | cut -c1-300)"; FAILED=1
  fi
elif [ "$PHASE" = wayland ]; then
  w foot-zsh       "sway foot zsh"       "sway|super+Return|exec foot"      -- foot zsh
  w foot-helix     "sway foot helix"     "foot|ctrl+shift+y|Spawns a new"   -- foot helix /tmp/e2e.rs
  w alacritty-way  "sway alacritty zsh"  "alacritty|ctrl+shift+x|Quit"      -- alacritty -e zsh
  w kitty-way      "sway kitty zsh"      "kitty|ctrl+shift+x|close_window"  -- kitty zsh
  # Picks under a faked GNOME session, through a fake RemoteDesktop portal (tests/e2e/fake_portal.py MODES): approved
  # (twice, the second with the stored token), refused, a stored token no longer honoured, a start that returns no
  # token, SelectDevices refused, no keyboard among the device types, no AvailableDeviceTypes at all, a Request on
  # another path, a Response forged by another client, a Close that fails, a failure before the portal sees the stored
  # token, no portal on the bus, a Start that grants no keyboard, a key press the portal fails. Each sent pick's keys
  # are checked as the keysyms pressed and released.
  p portal-send           send
  p portal-refused        refused
  p portal-stale          stale
  p portal-no-token       no-token
  p portal-select-refused select-refused
  p portal-no-keyboard    no-keyboard
  p portal-no-property    no-property
  p portal-other-path     other-path
  p portal-forged         forged
  p portal-close-fails    close-fails
  p portal-early-fail     early-fail
  p portal-absent         absent
  p portal-no-devices     no-devices
  p portal-keysym-fails   keysym-fails
elif [ "$PHASE" = niri ]; then
  # niri's binds from tests/e2e/home/.config/niri (Mod+T from its include) beside the terminal's, found through
  # `niri msg --json focused-window`. No oracle: nothing in niri's IPC or CLI prints its binds (the hotkey overlay
  # is drawn, not printed).
  n niri-foot      "niri foot zsh"       "niri|super+t|Open a Terminal"     -- foot zsh
  # A foot key picked by its description: its demo sends a key under niri (niri's own keys are refused by design).
  n niri-foot-key  "niri foot zsh"       "foot|ctrl+shift+y|Spawns a new"   -- foot zsh
fi
