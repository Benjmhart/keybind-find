# The e2e cases, sourced by harness.sh once per phase (PHASE=x11, awesome, wayland, then niri).
# Each names its case, the providers that must answer (each with at least one bind), and one key from tests/e2e/home
# that must be listed: "PROVIDER|KEY|part of its description[|scope=value,...]". x: under i3, or under awesome in its
# phase (the focused window found through xdotool); w: under sway; p NAME MODE: picks through a fake portal under a
# faked GNOME session on sway's display (harness.sh `p`); n: under niri; d: one provider dumped directly, after a setup
# command (its desktop can't run here); o NAME PROVIDER -- COMMAND: the program's own key report (COMMAND) checked
# against `keybind-find dump PROVIDER` by oracle.py. The niri phase runs only when its name is wanted: name
# `niri-phase` with any niri case.
if [ "$PHASE" = x11 ]; then
  # Programs in a terminal with no keys of its own (xterm), and i3's own keys.
  x xterm-zsh      "i3 zsh"     "i3|super+Return|exec xterm"        -- xterm -e zsh
  x zsh            "i3 zsh"     "zsh|ctrl+x k|kill-whole-line"      -- xterm -e zsh
  x bash           "i3 bash"    "bash|ctrl+x k|kill-whole-line"     -- xterm -e bash
  x fish           "i3 fish"    "fish|alt+k|kill-whole-line"        -- xterm -e fish
  x helix          "i3 helix"   "helix|ctrl+s|Write changes"        -- xterm -e helix /tmp/e2e.rs
  x vim-headless   "i3 vim"     "vim|space w|:w<CR>"                -- xterm -e vim /tmp/e2e.c
  # The buffer's own map, which only the running vim has: proves the live read.
  x vim-live       "i3 vim"     'vim|space b|:echo "buffer"|buffer=current,filetype=c' -- xterm -e vim --servername E2E /tmp/e2e.c
  x nano           "i3 nano"    "nano|ctrl+s|Save file"             -- xterm -e nano /tmp/e2e.c
  x micro          "i3 micro"   "micro|alt+s|Save"                  -- xterm -e micro /tmp/e2e.c
  x mc             "i3 mc"      "mc|alt+y|Quit"                     -- xterm -e mc
  x ranger         "i3 ranger"  "ranger|shift+x|quit"               -- xterm -e ranger
  x ncmpcpp        "i3 ncmpcpp" "ncmpcpp|shift+x|quit"              -- xterm -e ncmpcpp
  x yazi           "i3 yazi"    "yazi|shift+x|e2e quit"             -- xterm -e yazi
  x emacs-nw       "i3 emacs"   "emacs|ctrl+c k|kill-buffer"        -- xterm -e emacs -nw /tmp/e2e.c
  # c-mode's map, which only the running Emacs's C buffer has (the batch read lists the global map): proves the
  # server path.
  wanted emacsclient-t && emacs --daemon >/dev/null 2>&1
  x emacsclient-t  "i3 emacs"   "emacs|ctrl+c j|kill-buffer"        -- xterm -e emacsclient -t /tmp/e2e.c
  x screen         "i3 screen"  "screen|ctrl+a shift+x|quit"        -- xterm -e screen
  x tmux           "i3 tmux"    "tmux|ctrl+b X|kill-server"         -- xterm -e tmux
  # Alt as ESC: by default xterm sets the eighth bit instead (Alt+y types `ù`), which zellij doesn't read as Alt.
  x zellij         "i3 zellij"  "zellij|alt+y|NewTab|input_mode=normal" -- xterm -xrm 'XTerm*metaSendsEscape: true' -e zellij
  # nvim in zellij's one pane, from `zellij action list-clients`. The zellij case's server goes first, gone before the
  # case starts (with two sessions zellij asks which), and the server gets EDITOR=nvim: zellij shows a pane running nvim
  # on one file under its editor's name when that is vi, vim or nvim (vi when unset).
  wanted zellij-nvim && pkill -x zellij && for _ in $(seq 50); do pgrep -x zellij >/dev/null || break; sleep 0.1; done
  wanted zellij-nvim && { ! pgrep -x zellij >/dev/null || echo "zellij still running" >&2; }
  x zellij-nvim    "i3 zellij nvim" "nvim|backslash x|e2e quit"       -- xterm -e env EDITOR=nvim zellij --layout /tmp/home/.config/zellij/nvim.kdl
  pkill -x zellij || true
  x less           "i3 less"    "less|X|quit"                       -- xterm -e less /etc/os-release
  # sxhkd's hotkeys beside i3's, from the sxhkd running on this display (stopped after, so later cases don't list it).
  # sxhkd exits without SHELL (it runs commands through it), which the harness leaves unset.
  wanted sxhkd && { SHELL=/bin/sh sxhkd >"$OUT/sxhkd.log" 2>&1 & }
  wanted sxhkd && for _ in $(seq 50); do pgrep -x sxhkd >/dev/null && break; sleep 0.1; done
  x sxhkd          "i3 sxhkd zsh" "sxhkd|super+alt+x|e2e quit"       -- xterm -e zsh
  wanted sxhkd && pkill -x sxhkd && for _ in $(seq 50); do pgrep -x sxhkd >/dev/null || break; sleep 0.1; done
  # Terminals with keys of their own, a shell inside.
  x alacritty      "i3 alacritty zsh"       "alacritty|ctrl+shift+x|Quit"          -- alacritty -e zsh
  x kitty          "i3 kitty zsh"           "kitty|ctrl+shift+x|close_window"      -- kitty zsh
  x ghostty        "i3 ghostty zsh"         "ghostty|ctrl+shift+x|close_surface"   -- ghostty -e zsh
  x xfce4-terminal "i3 xfce4_terminal zsh"  "xfce4_terminal|ctrl+shift+n|Open Tab" -- xfce4-terminal --disable-server -x zsh
  wanted gnome-terminal && gsettings set org.gnome.Terminal.Legacy.Keybindings:/org/gnome/terminal/legacy/keybindings/ close-tab '<Control><Shift>x'
  x gnome-terminal "i3 gnome-terminal zsh"  "gnome-terminal|ctrl+shift+x|close tab" -- gnome-terminal --wait -- zsh
  x urxvt          "i3 zsh"                 "zsh|ctrl+x k|kill-whole-line"         -- urxvt -e zsh
  x terminator     "i3 zsh"                 "zsh|ctrl+x k|kill-whole-line"         -- terminator -x zsh
  x wezterm        "i3 wezterm zsh"         "wezterm|ctrl+shift+x|CloseCurrentTab" -- wezterm start --always-new-process -- zsh
  x konsole        "i3 konsole zsh"         "konsole|ctrl+shift+x|Close Window"    -- konsole -e zsh
  # A second pane, focused on creation: the program in it comes from `wezterm cli list-clients`.
  x wezterm-split  "i3 wezterm helix"       "helix|ctrl+s|Write changes"           -- wezterm start --always-new-process -- zsh -c 'wezterm cli split-pane -- helix /tmp/e2e.rs; exec zsh'
  # Apps by window class.
  x zathura        "i3 zathura"  "zathura|shift+x|quit"                   -- zathura
  x mpv            "i3 mpv"      "mpv|shift+x|quit"                       -- mpv --idle --force-window
  x code           "i3 vscode"   "vscode|ctrl+shift+x|workbench.action.quit" -- code --no-sandbox --disable-gpu --new-window /tmp/e2e.rs
  x obsidian       "i3 obsidian" "obsidian|ctrl+shift+x|app:quit"         -- obsidian --no-sandbox
  x zed            "i3 zed"      "zed|ctrl+shift+x|CloseWindow"           -- zeditor --foreground /tmp/e2e.rs
  # Desktops that can't run here: their providers, from the settings store.
  d xfce   xfce  "xfce|super+t|xterm"   -- sh -c "xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>t' -n -t string -s xterm && xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom/override -n -t bool -s true"
  d gnome  gnome "gnome|super+q|close"  -- gsettings set org.gnome.desktop.wm.keybindings close "['<Super>q']"
  # The program as oracle: its own report of its effective keys against `keybind-find dump PROVIDER`, key for key
  # (tests/e2e/oracle.py; known differences listed there with their reasons).
  o kitty-oracle kitty -- kitty +runpy "$(cat "$E/oracle-kitty.py")" "$HOME/.config/kitty/kitty.conf"
  o wezterm-oracle wezterm -- wezterm show-keys --lua
  # zellij prints no effective keys: its preset is the oracle, the config's changes its KNOWN differences.
  o zellij-oracle zellij -- zellij setup --dump-keybinds default
elif [ "$PHASE" = awesome ]; then
  # awesome on the same display, i3 stopped: its keys from the running awesome over D-Bus
  # (tests/e2e/home/.config/awesome/rc.lua: the stock rc.lua plus keys of our own).
  x awesome        "awesome zsh"  "awesome|super+shift+x|e2e quit"   -- xterm -e zsh
  # awesome's own report: its installed root.keys() as hex MODS,KEY, without the Lock and Mod2 variants awful.key adds
  # (lib/awful/key.lua:24,120-130 at v4.3), deduplicated. Global keys only: the stock rc's client keys are KNOWN.
  AWESOME_REPORT='local function h(s) return (s:gsub(".", function(c) return ("%02x"):format(c:byte()) end)) end
local o, seen = {}, {}
for _, k in ipairs(root.keys()) do
  local m = {}
  for _, x in ipairs(k.modifiers) do if x ~= "Lock" and x ~= "Mod2" then m[#m + 1] = x end end
  local e = h(table.concat(m, "\0")) .. "," .. h(k.key or "")
  if not seen[e] then seen[e], o[#o + 1] = true, e end
end
return table.concat(o, ";")'
  o awesome-oracle awesome -- dbus-send --session --dest=org.awesomewm.awful --type=method_call --print-reply \
    --reply-timeout=2000 / org.awesomewm.awful.Remote.Eval "string:$AWESOME_REPORT"
elif [ "$PHASE" = wayland ]; then
  w foot-zsh       "sway foot zsh"       "sway|super+Return|exec foot"      -- foot zsh
  w foot-helix     "sway foot helix"     "foot|ctrl+shift+y|Spawns a new"   -- foot helix /tmp/e2e.rs
  w alacritty-way  "sway alacritty zsh"  "alacritty|ctrl+shift+x|Quit"      -- alacritty -e zsh
  w kitty-way      "sway kitty zsh"      "kitty|ctrl+shift+x|close_window"  -- kitty zsh
  # Picks under a faked GNOME session, through a fake RemoteDesktop portal (tests/e2e/fake_portal.py MODES): approved
  # (twice, the second with the stored token), refused, a stored token no longer honoured, a start that returns no
  # token, SelectDevices refused, no keyboard among the device types, no AvailableDeviceTypes at all, a Request on
  # another path, a Response forged by another client, a Close that fails, a failure before the portal sees the stored
  # token, no portal on the bus, a Start that grants no keyboard, a key press the portal fails. Each sent pick's keys
  # are checked as the keysyms pressed and released.
  p portal-send           send
  p portal-refused        refused
  p portal-stale          stale
  p portal-no-token       no-token
  p portal-select-refused select-refused
  p portal-no-keyboard    no-keyboard
  p portal-no-property    no-property
  p portal-other-path     other-path
  p portal-forged         forged
  p portal-close-fails    close-fails
  p portal-early-fail     early-fail
  p portal-absent         absent
  p portal-no-devices     no-devices
  p portal-keysym-fails   keysym-fails
elif [ "$PHASE" = niri ]; then
  # niri's binds from tests/e2e/home/.config/niri (Mod+T from its include) beside the terminal's, found through
  # `niri msg --json focused-window`. No oracle: nothing in niri's IPC or CLI prints its binds (the hotkey overlay
  # is drawn, not printed).
  n niri-foot      "niri foot zsh"       "niri|super+t|Open a Terminal"     -- foot zsh
  # A foot key picked by its description: its demo sends a key under niri (niri's own keys are refused by design).
  n niri-foot-key  "niri foot zsh"       "foot|ctrl+shift+y|Spawns a new"   -- foot zsh
fi
