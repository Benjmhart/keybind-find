# The e2e cases, sourced by harness.sh twice (PHASE=x11, then PHASE=wayland). Each names its case, the providers
# that must answer, and one key from tests/e2e/home that must be listed ("PROVIDER|KEY|part of its description",
# or - for none), then the command. x: under i3 (the focused window found through xdotool); w: under sway;
# d: one provider dumped directly, after a setup command (its desktop can't run here).
if [ "$PHASE" = x11 ]; then
  # Programs in a terminal with no keys of its own (xterm), and i3's own keys.
  x xterm-zsh      "i3 zsh"     "i3|super+Return|exec xterm"       -- xterm -e zsh
  x xterm-bash     "i3 bash"    -                                  -- xterm -e bash
  x xterm-fish     "i3 fish"    -                                  -- xterm -e fish
  x helix          "i3 helix"   "helix|ctrl+s|Write changes"       -- xterm -e helix /tmp/e2e.rs
  x vim-headless   "i3 vim"     "vim|space w|:w<CR>"               -- xterm -e vim /tmp/e2e.c
  x vim-live       "i3 vim"     'vim|space b|:echo "buffer"'       -- xterm -e vim --servername E2E /tmp/e2e.c
  x nano           "i3 nano"    "nano|ctrl+s|Save file"            -- xterm -e nano /tmp/e2e.c
  x micro          "i3 micro"   "micro|alt+s|Save"                 -- xterm -e micro /tmp/e2e.c
  x mc             "i3 mc"      -                                  -- xterm -e mc
  x ranger         "i3 ranger"  "ranger|shift+x|quit"              -- xterm -e ranger
  x ncmpcpp        "i3 ncmpcpp" "ncmpcpp|shift+x|quit"             -- xterm -e ncmpcpp
  x yazi           "i3 yazi"    -                                  -- xterm -e yazi
  x emacs-nw       "i3 emacs"   "emacs|ctrl+c k|kill-buffer"       -- xterm -e emacs -nw /tmp/e2e.c
  emacs --daemon >/dev/null 2>&1
  x emacsclient-t  "i3 emacs"   "emacs|ctrl+c k|kill-buffer"       -- xterm -e emacsclient -t /tmp/e2e.c
  x screen         "i3 screen"  -                                  -- xterm -e screen
  x tmux           "i3 tmux"    -                                  -- xterm -e tmux
  x less           "i3 less"    -                                  -- xterm -e less /etc/os-release
  # Terminals with keys of their own, a shell inside.
  x alacritty      "i3 alacritty zsh"       -                                    -- alacritty -e zsh
  x kitty          "i3 kitty zsh"           "kitty|ctrl+shift+x|close_window"    -- kitty zsh
  x ghostty        "i3 ghostty zsh"         "ghostty|ctrl+shift+x|close_surface" -- ghostty -e zsh
  x xfce4-terminal "i3 xfce4_terminal zsh"  "xfce4_terminal|ctrl+shift+n|Open Tab" -- xfce4-terminal --disable-server -x zsh
  x gnome-terminal "i3 gnome-terminal zsh"  -                                    -- gnome-terminal --wait -- zsh
  x urxvt          "i3 zsh"                 -                                    -- urxvt -e zsh
  x terminator     "i3 zsh"                 -                                    -- terminator -x zsh
  x wezterm        "i3 zsh"                 -                                    -- wezterm start --always-new-process -- zsh
  # Apps by window class.
  x zathura        "i3 zathura"  -    -- zathura
  x mpv            "i3 mpv"      -    -- mpv --idle --force-window --no-config
  x code           "i3 vscode"   - 8  -- code --no-sandbox --disable-gpu --new-window /tmp/e2e.rs
  x obsidian       "i3 obsidian" - 6  -- obsidian --no-sandbox
  x zed            "i3 zed"      - 6  -- zeditor --foreground /tmp/e2e.rs
  # Desktops that can't run here: their providers, from the settings store.
  d xfce   xfce  "xfce|super+t|xterm"   -- sh -c "xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>t' -n -t string -s xterm && xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom/override -n -t bool -s true"
  d gnome  gnome "gnome|super+q|close"  -- gsettings set org.gnome.desktop.wm.keybindings close "['<Super>q']"
else
  w foot-zsh       "sway foot zsh"       "sway|super+Return|exec foot"  -- foot zsh
  w foot-helix     "sway foot helix"     "foot|ctrl+shift+y|Spawns a new" -- foot helix /tmp/e2e.rs
  w alacritty-way  "sway alacritty zsh"  -                              -- alacritty -e zsh
  w kitty-way      "sway kitty zsh"      "kitty|ctrl+shift+x|close_window" -- kitty zsh
fi
