#!/usr/bin/env bash
# Records one e2e case as a GIF for a provider PR's Demo section: the case's program, keybind-find's picker over it,
# QUERY typed and a pick sending its key. Builds the image and keybind-find as tests/e2e/run does; needs only Docker.
#
#   tests/e2e/record CASE [QUERY]    QUERY: what to type in the picker (default: the case's description part)
#   E2E_OUT=dir tests/e2e/record …   where CASE.gif goes (default: target/e2e-record in this checkout)
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
case=${1:-}
[ -n "$case" ] || { echo "usage: tests/e2e/record CASE [QUERY]" >&2; exit 2; }
# The case's form, from its line in `cases`: d and o cases have no window to show.
form=$(awk -v c="$case" '$2 == c && $1 ~ /^[a-z]$/ { print $1; exit }' "$here/cases")
[ -n "$form" ] || { echo "record: no case $case in tests/e2e/cases" >&2; exit 2; }
case $form in d | o) echo "record: $case is a \`$form\` case, with no window to record" >&2; exit 2 ;; esac
out=${E2E_OUT:-$repo/target/e2e-record}
mkdir -p "$out"
# Written by the image's user, whose uid may not be ours.
chmod a+rwx "$out"
out=$(cd "$out" && pwd)
image=keybind-find-e2e
docker build -t "$image" "$here" >&2
volumes=(-v "$repo:/src:ro" -v keybind-find-e2e-target:/target -v keybind-find-e2e-cargo:/home/tester/.cargo/registry)
docker run --rm "${volumes[@]}" "$image" bash /src/tests/e2e/harness.sh build
status=0
docker run --rm --init --shm-size=1g --network none "${volumes[@]}" -v "$out:/tmp/out" \
  -e RECORD=1 -e "CASES=$case" -e "QUERY=${2:-}" \
  "$image" bash /src/tests/e2e/harness.sh || status=$?
gif=$out/$case.gif
[ -f "$gif" ] && echo "$gif ($(du -h "$gif" | cut -f1))"
exit "$status"
